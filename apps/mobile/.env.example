# API base URL — read at build time via app.config.ts → Constants.expoConfig.extra.apiBaseUrl
API_BASE_URL=https://api.cambio.sneyderangulo.com

# Umami analytics (optional)
#
# Enabled only when UMAMI_ENABLED=true and both UMAMI_HOST + UMAMI_WEBSITE_ID are set.
UMAMI_ENABLED=false
UMAMI_HOST=""
UMAMI_WEBSITE_ID=""

# Firebase (same project as web)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_STORAGE_BUCKET=""

# Google Sign-In (native @react-native-google-signin)
# This is the "Web client" OAuth 2.0 Client ID from Google Cloud Console.
# Firebase creates one automatically — find it in:
# Firebase Console → Authentication → Sign-in method → Google → "Web client ID"
# It is passed as webClientId to GoogleSignin.configure() so that
# signIn() returns an idToken usable with Firebase signInWithCredential().
GOOGLE_WEB_CLIENT_ID=""
