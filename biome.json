{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
      "includes": [
        "**",
        "!!**/android/.gradle",
        "!!**/android/build",
        "!!**/ios/Pods",
        "!!**/ios/build"
      ]
    },
    "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
    },
    "linter": { "enabled": true },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    },
    "overrides": [
      {
        "includes": ["apps/web/**/*.css"],
        "css": { "parser": { "tailwindDirectives": true } }
      }
    ],
    "assist": {
      "actions": {
        "source": {
          "organizeImports": "on"
        }
      }
    }
  }
